# ──────────────────────────────────────────────────────────────────────────────
#  PostHog Swarm deployment — environment configuration
#  Copy this file to `.env` and fill in real values. Never commit `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Identity & networking ────────────────────────────────────────────────────
# Public hostname users will hit. Must resolve to BM2's public IP.
SITE_URL=https://posthog.example.com
DOMAIN=posthog.example.com
# Email for Let's Encrypt registration & cert expiry alerts.
ACME_EMAIL=ops@example.com

# LAN IPs used for Swarm advertise-addr and for capture→Kafka traffic.
BM1_LAN_IP=10.0.0.11
BM2_LAN_IP=10.0.0.12

# Set per-node before running bootstrap-host.sh. The script consumes this to
# decide whether to build the RAID mirror.
#   On BM1: NODE_ROLE=data
#   On BM2: NODE_ROLE=app
NODE_ROLE=data

# Optional: lets init-swarm.sh ssh to BM2 to join and label automatically.
# Leave blank to do the join step manually.
BM2_SSH=root@10.0.0.12

# ─── Image tags ───────────────────────────────────────────────────────────────
# Pin to a known-good release. See https://hub.docker.com/r/posthog/posthog/tags
POSTHOG_IMAGE_TAG=release-2025-04-25
CLICKHOUSE_IMAGE_TAG=24.8-alpine
KAFKA_IMAGE_TAG=7.7.0
ZOOKEEPER_IMAGE_TAG=7.7.0
POSTGRES_IMAGE_TAG=15.12-alpine
REDIS_IMAGE_TAG=7.2-alpine
MINIO_IMAGE_TAG=RELEASE.2025-04-22T22-12-26Z
CADDY_IMAGE_TAG=2-alpine

# ─── Secrets — change every one of these before first deploy ──────────────────
# `openssl rand -hex 32` for SECRET_KEY and ENCRYPTION_SALT_KEYS
SECRET_KEY=CHANGEME_openssl_rand_hex_32
ENCRYPTION_SALT_KEYS=CHANGEME_openssl_rand_hex_32

POSTGRES_USER=posthog
POSTGRES_PASSWORD=CHANGEME_strong_password
POSTGRES_DB=posthog

CLICKHOUSE_USER=posthog
CLICKHOUSE_PASSWORD=CHANGEME_strong_password
CLICKHOUSE_DATABASE=posthog

REDIS_PASSWORD=CHANGEME_strong_password

OBJECT_STORAGE_ACCESS_KEY_ID=posthog
OBJECT_STORAGE_SECRET_ACCESS_KEY=CHANGEME_strong_password
OBJECT_STORAGE_BUCKET=posthog
OBJECT_STORAGE_ENDPOINT=http://objectstorage:9000

# ─── PostHog feature toggles ──────────────────────────────────────────────────
DEPLOYMENT=baremetal-swarm
DISABLE_SECURE_SSL_REDIRECT=0
IS_BEHIND_PROXY=1
TRUSTED_PROXIES=10.0.0.0/8
DEBUG=0
SENTRY_DSN=

# ─── Resource caps (override the defaults in docker-stack.yml if needed) ─────
CLICKHOUSE_MAX_MEMORY=28G
KAFKA_HEAP_OPTS=-Xmx4G -Xms2G

# ─── Backup policy ────────────────────────────────────────────────────────────
BACKUP_RETAIN_DAILY=7
BACKUP_RETAIN_WEEKLY=4
BACKUP_REMOTE_RSYNC_TARGET=root@${BM2_LAN_IP}:/opt/posthog/data/backups/

# Optional off-site S3 mirror (leave blank to disable)
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
