# ──────────────────────────────────────────────────────────────────────────────
#  PostHog reverse proxy — HTTP-only mode (TLS terminated by Cloudflare tunnel)
#
#  cloudflared on BM2 receives encrypted traffic from Cloudflare's edge,
#  decrypts it, and forwards plain HTTP to this Caddy on localhost:80.
#  We must NOT redirect to HTTPS or run our own ACME — Cloudflare does that.
#
#  Routes:
#    /minio/*    → MinIO console (admin only)
#    /*          → web (Django: dashboard, API, capture endpoints)
# ──────────────────────────────────────────────────────────────────────────────

{
    # Disable automatic HTTPS/ACME — Cloudflare provides the cert.
    auto_https off
    servers {
        # The X-Forwarded-* headers come from cloudflared (localhost / docker
        # bridge ranges) — trust those so Caddy passes through Cloudflare's
        # CF-Connecting-IP as the real client IP downstream.
        trusted_proxies static private_ranges
    }
}

# Plain HTTP on port 80 — cloudflared is the only thing that should reach this.
:80 {
    encode zstd gzip

    # Use Cloudflare's real-client header if present.
    request_header X-Forwarded-Proto https
    request_header X-Forwarded-Host pg.xcelerator.in

    # ── MinIO console (lock this down at Cloudflare Access if exposed) ──────
    handle_path /minio/* {
        reverse_proxy objectstorage:9001
    }

    # ── Everything else → web (dashboard + capture endpoints) ───────────────
    handle {
        reverse_proxy web:8000 {
            health_uri /_health
            health_interval 30s
            lb_policy least_conn
            transport http {
                keepalive 30s
                response_header_timeout 120s
            }
        }
    }

    log {
        output stdout
        format json
        level INFO
    }
}
