<?xml version="1.0"?>
<!--
  Read-only "default" user is disabled; PostHog connects as the env-provided
  user (created by the entrypoint from CLICKHOUSE_USER / CLICKHOUSE_PASSWORD).
-->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>17179869184</max_memory_usage>
            <max_bytes_before_external_group_by>8589934592</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>8589934592</max_bytes_before_external_sort>
            <max_execution_time>180</max_execution_time>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
            <log_queries>1</log_queries>
            <distributed_aggregation_memory_efficient>1</distributed_aggregation_memory_efficient>
        </default>
        <readonly>
            <readonly>1</readonly>
            <max_execution_time>30</max_execution_time>
        </readonly>
    </profiles>

    <users>
        <default>
            <!-- Disable anonymous default access -->
            <password></password>
            <networks>
                <ip>127.0.0.1</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </default>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
