# ──────────────────────────────────────────────────────────────────────────────
#  .env for BM2 (Xeon 4208 / 48 GB ECC / 1x500 GB NVMe — app plane)
#
#  Copy to /opt/posthog-selfhosted/.env on BM2.
#  IMPORTANT: secrets MUST be IDENTICAL to BM1's .env so the services running
#  on either node can authenticate to each other. Regenerate before prod, and
#  keep both files in sync.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Identity & networking ────────────────────────────────────────────────────
SITE_URL=https://posthog.example.com
DOMAIN=posthog.example.com
ACME_EMAIL=ops@example.com

BM1_LAN_IP=22.0.3.194
BM2_LAN_IP=22.0.3.195

# This node IS BM2 — the app plane
NODE_ROLE=app

# Not needed on BM2 (only init-swarm.sh on BM1 uses it)
BM2_SSH=

# ─── Image tags ───────────────────────────────────────────────────────────────
POSTHOG_IMAGE_TAG=release-2025-04-25
CLICKHOUSE_IMAGE_TAG=24.8-alpine
KAFKA_IMAGE_TAG=7.7.0
ZOOKEEPER_IMAGE_TAG=7.7.0
POSTGRES_IMAGE_TAG=15.12-alpine
REDIS_IMAGE_TAG=7.2-alpine
MINIO_IMAGE_TAG=RELEASE.2025-04-22T22-12-26Z
CADDY_IMAGE_TAG=2-alpine

# ─── Secrets — IDENTICAL to BM1 ───────────────────────────────────────────────
SECRET_KEY=c22dd9131ca71a0ccea93af44d91f73fcc5e4cf05e972d127959bbf6a80c171b
ENCRYPTION_SALT_KEYS=ed28319cb7e566b282db38e9cdd176924ca40c3e2255b79e41494979a526c5ad

POSTGRES_USER=posthog
POSTGRES_PASSWORD=1207a59b7cd9cb55520bb17977dda0c0637a93fa77cf6d84359abc9dac640b67
POSTGRES_DB=posthog

CLICKHOUSE_USER=posthog
CLICKHOUSE_PASSWORD=74e32957739e041c16c71aa52ff0a15f99d9af8919d6086d1786992cb8cf8d94
CLICKHOUSE_DATABASE=posthog

REDIS_PASSWORD=94861d31f849defc643bf28d8abf0d466a734e5dd78e2673be0042fd6a01bd4a

OBJECT_STORAGE_ACCESS_KEY_ID=posthog
OBJECT_STORAGE_SECRET_ACCESS_KEY=deff9039527a4f30f71b358d939ef5b93d121b9552bd5646f0d99960447bd3d6
OBJECT_STORAGE_BUCKET=posthog
OBJECT_STORAGE_ENDPOINT=http://objectstorage:9000

# ─── PostHog feature toggles ──────────────────────────────────────────────────
DEPLOYMENT=baremetal-swarm
DISABLE_SECURE_SSL_REDIRECT=0
IS_BEHIND_PROXY=1
TRUSTED_PROXIES=22.0.3.0/24
DEBUG=0
SENTRY_DSN=

# ─── Resource caps (unused on BM2 — kept for parity) ─────────────────────────
CLICKHOUSE_MAX_MEMORY=28G
KAFKA_HEAP_OPTS="-Xmx4G -Xms2G"

# ─── Backup policy (the cron + script run on BM1; here for parity only) ─────
BACKUP_RETAIN_DAILY=7
BACKUP_RETAIN_WEEKLY=4
BACKUP_REMOTE_RSYNC_TARGET=root@22.0.3.195:/opt/posthog/data/backups/

BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
